# AlertManager configuration
# Jinja2 template - secrets injected from vault.yml

global:
  # SMTP Configuration 
  smtp_smarthost: "{{ alertmanager_smtp_host }}"
  smtp_from: "{{ vault_alert_email_from }}"
  smtp_auth_username: "{{ vault_alert_email_from }}"
  smtp_auth_password: "{{ vault_alert_email_password }}"
  smtp_require_tls: {{ alertmanager_smtp_require_tls }}

  # Global Timeouts 
  resolve_timeout: "5m"

#  Templates 
templates:
  - "/etc/alertmanager/config/*.tmpl"

# Routing 
route:
  # Default receiver
  receiver: "email-notifications"

  # Group alerts together
  group_by:
    - alertname
    - cluster
    - namespace
    - severity

  # Wait before sending first alert
  group_wait: "30s"

  # Wait before sending new alerts for same group
  group_interval: "5m"

  # Wait before re-sending resolved alert
  repeat_interval: "4h"

  # Sub-routes (priority order) 
  routes:
    # Critical alerts → immediate notification
    - receiver: "email-critical"
      match:
        severity: "critical"
      group_wait: "10s"
      repeat_interval: "1h"
      continue: false

    # Warning alerts → standard notification
    - receiver: "email-notifications"
      match:
        severity: "warning"
      group_wait: "30s"
      repeat_interval: "4h"
      continue: false

    # Watchdog (heartbeat) → silence it
    - receiver: "null"
      match:
        alertname: "Watchdog"
      continue: false

    # InfoInhibitor → silence it
    - receiver: "null"
      match:
        alertname: "InfoInhibitor"
      continue: false

#  Inhibit Rules 
# Suppress warning when critical firing for same resource
inhibit_rules:
  - source_match:
      severity: "critical"
    target_match:
      severity: "warning"
    equal:
      - alertname
      - namespace
      - pod

  - source_match:
      severity: "critical"
    target_match:
      severity: "info"
    equal:
      - alertname
      - namespace

# Receivers 
receivers:
  # Null receiver (silences) 
  - name: "null"

  # Critical Alerts 
  - name: "email-critical"
    email_configs:
      - to: "{{ vault_alert_email_to }}"
        send_resolved: true
        headers:
          Subject: >-
            🚨 [CRITICAL] {{ "{{" }} .GroupLabels.alertname {{ "}}" }}
            | {{ "{{" }} .CommonLabels.namespace {{ "}}" }}
            | EKS ecommerce-eks-{{ environment }}
        html: |
          <h2 style="color: #dc2626;">🚨 CRITICAL ALERT</h2>
          <table border="1" cellpadding="8" style="border-collapse:collapse;">
            <tr><th>Field</th><th>Value</th></tr>
            <tr><td><b>Alert</b></td>
                <td>{{ "{{" }} .GroupLabels.alertname {{ "}}" }}</td></tr>
            <tr><td><b>Namespace</b></td>
                <td>{{ "{{" }} .CommonLabels.namespace {{ "}}" }}</td></tr>
            <tr><td><b>Severity</b></td>
                <td style="color:#dc2626;"><b>CRITICAL</b></td></tr>
            <tr><td><b>Environment</b></td>
                <td>{{ environment }}</td></tr>
            <tr><td><b>Cluster</b></td>
                <td>{{ cluster_name }}</td></tr>
            <tr><td><b>Started</b></td>
                <td>{{ "{{" }} .Alerts.Firing | len {{ "}}" }} alert(s) firing</td></tr>
          </table>
          <h3>Alert Details:</h3>
          {{ "{{-" }} range .Alerts {{ "}}" }}
          <p>
            <b>Summary:</b>
            {{ "{{" }} .Annotations.summary {{ "}}" }}<br/>
            <b>Description:</b>
            {{ "{{" }} .Annotations.description {{ "}}" }}<br/>
            <b>Pod:</b>
            {{ "{{" }} .Labels.pod {{ "}}" }}<br/>
            <b>Node:</b>
            {{ "{{" }} .Labels.node {{ "}}" }}
          </p>
          {{ "{{-" }} end {{ "}}" }}
          <hr/>
          <p style="color:#6b7280; font-size:12px;">
            EKS Cluster: {{ cluster_name }} |
            Environment: {{ environment }} |
            Auto-generated by AlertManager
          </p>

  # Warning + Info Alerts 
  - name: "email-notifications"
    email_configs:
      - to: "{{ vault_alert_email_to }}"
        send_resolved: true
        headers:
          Subject: >-
            ⚠️ [WARNING] {{ "{{" }} .GroupLabels.alertname {{ "}}" }}
            | {{ "{{" }} .CommonLabels.namespace {{ "}}" }}
            | EKS ecommerce-eks-{{ environment }}
        html: |
          <h2 style="color: #d97706;">⚠️ WARNING ALERT</h2>
          <table border="1" cellpadding="8" style="border-collapse:collapse;">
            <tr><th>Field</th><th>Value</th></tr>
            <tr><td><b>Alert</b></td>
                <td>{{ "{{" }} .GroupLabels.alertname {{ "}}" }}</td></tr>
            <tr><td><b>Namespace</b></td>
                <td>{{ "{{" }} .CommonLabels.namespace {{ "}}" }}</td></tr>
            <tr><td><b>Severity</b></td>
                <td style="color:#d97706;"><b>WARNING</b></td></tr>
            <tr><td><b>Environment</b></td>
                <td>{{ environment }}</td></tr>
            <tr><td><b>Cluster</b></td>
                <td>{{ cluster_name }}</td></tr>
          </table>
          <h3>Alert Details:</h3>
          {{ "{{-" }} range .Alerts {{ "}}" }}
          <p>
            <b>Summary:</b>
            {{ "{{" }} .Annotations.summary {{ "}}" }}<br/>
            <b>Description:</b>
            {{ "{{" }} .Annotations.description {{ "}}" }}
          </p>
          {{ "{{-" }} end {{ "}}" }}
          <hr/>
          <p style="color:#6b7280; font-size:12px;">
            EKS Cluster: {{ cluster_name }} |
            Environment: {{ environment }} |
            Auto-generated by AlertManager
          </p>